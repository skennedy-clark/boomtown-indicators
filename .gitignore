# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Cache — downloaded raw data files (can be large, regenerated by scripts) ──
cache/
# Exception: keep the cache directory structure but not its contents
!cache/.gitkeep

# ── Logs — generated on every run ─────────────────────────────────────────────
logs/
!logs/.gitkeep

# ── Output / staging ──────────────────────────────────────────────────────────
output/
staging/
!output/.gitkeep

# ── Sensitive / personal config ───────────────────────────────────────────────
# If you ever add API keys or credentials, keep them out of the repo
.env
secrets.toml
credentials.json
*.key

# ── OS cruft ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Jupyter (if notebooks are added later) ────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Specific large data files that should not be committed ────────────────────
# Raw ATO, ABS, QPS downloads belong in cache/ (above), but just in case
*.xlsx
*.xls
*.csv
# Exception: towns.toml config IS committed — it's source, not data
!towns.toml
